# === Backend selection ===
# Prefer Vertex when GOOGLE_CLOUD_PROJECT is set.
# Force Gemini Developer API even if a project is set:
# GOOGLE_GENAI_USE_GEMINI_API=true
# Force Vertex:
# GOOGLE_GENAI_USE_VERTEXAI=true

# --- Vertex AI (Google Cloud Console) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional: path to a service-account JSON. Otherwise use ADC:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# --- Gemini Developer API (AI Studio key) — also supported ---
# GOOGLE_API_KEY=
